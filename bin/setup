#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COZY_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cozy-version.conf")"
DEFAULT_CNCF_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cncf-version.conf")"
DEFAULT_CNCF_SERVER_PORT="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cncf-server-port.conf")"
DEFAULT_CORE_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/goldenport-core-version.conf")"
DEFAULT_SIMPLEMODELING_MODEL_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/simplemodeling-model-version.conf")"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}"
LAUNCHER_ROOT="$CACHE_ROOT/cncf-samples/cozy-launcher/$COZY_VERSION"
STATE_FILE="$LAUNCHER_ROOT/.setup-complete"
CS_VERSION_FILE="$REPO_ROOT/versions/coursier-version.conf"
CNCF_COURSIER_CACHE="$REPO_ROOT/.cache/coursier"

usage() {
  cat <<'EOF'
Usage:
  bin/setup
  bin/setup bootstrap
  bin/setup cozy
  bin/setup cncf [--cncf-version <version>] [--cncf-server-port <port>] [--core-version <version>] [--simplemodeling-model-version <version>]
  bin/setup all

Current responsibilities:
  - prepare the cozy launcher used by bin/cozy
  - verify the coursier-installed cncf command used directly by samples
  - verify cozy dependency resolution for the configured version
EOF
}

cncf_version="${CNCF_VERSION:-$DEFAULT_CNCF_VERSION}"
cncf_server_port="${CNCF_SERVER_PORT:-$DEFAULT_CNCF_SERVER_PORT}"
core_version="${GOLDENPORT_CORE_VERSION:-$DEFAULT_CORE_VERSION}"
simplemodeling_model_version="${SIMPLEMODELING_MODEL_VERSION:-$DEFAULT_SIMPLEMODELING_MODEL_VERSION}"

find_coursier() {
  if command -v cs >/dev/null 2>&1; then
    command -v cs
    return
  fi
  if command -v coursier >/dev/null 2>&1; then
    command -v coursier
    return
  fi
  return 1
}

canonical_path() {
  local path="$1"
  local dir
  dir="$(cd "$(dirname "$path")" && pwd -P)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

find_installed_cncf() {
  if [[ -n "${CNCF_COMMAND:-}" ]]; then
    printf '%s\n' "$CNCF_COMMAND"
    return
  fi
  local candidate=""
  candidate="$(command -v cncf || true)"
  if [[ -n "$candidate" ]]; then
    local self candidate_path
    self="$(canonical_path "$REPO_ROOT/bin/cncf")"
    candidate_path="$(canonical_path "$candidate")"
    if [[ "$candidate_path" != "$self" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  fi
  return 1
}

cozy_dependency_coords() {
  printf '"org.simplemodeling" %%%% "cozy" %% "%s"' "$COZY_VERSION"
}

is_snapshot() {
  [[ "$COZY_VERSION" == *-SNAPSHOT ]]
}

write_launcher_files() {
  mkdir -p "$LAUNCHER_ROOT/project"
  local resolver_block
  local dependency_coords
  dependency_coords="$(cozy_dependency_coords)"
  if is_snapshot; then
    resolver_block='  resolvers += Resolver.defaultLocal,
  resolvers += "GitHab releases 2020" at "https://raw.github.com/asami/maven-repository/2020/releases",
  resolvers += "GitHab releases 2025" at "https://raw.github.com/asami/maven-repository/2025/releases",
  resolvers += "GitHub Packages" at "https://maven.pkg.github.com/asami/maven-repository",
  credentials += Credentials(Path.userHome / ".sbt" / ".credentials"),'
  else
    resolver_block='  resolvers += "GitHab releases 2020" at "https://raw.github.com/asami/maven-repository/2020/releases",
  resolvers += "GitHab releases 2025" at "https://raw.github.com/asami/maven-repository/2025/releases",
  resolvers += "GitHub Packages" at "https://maven.pkg.github.com/asami/maven-repository",
  credentials += Credentials(Path.userHome / ".sbt" / ".credentials"),'
  fi
  cat > "$LAUNCHER_ROOT/build.sbt" <<EOF
ThisBuild / scalaVersion := "2.12.18"
ThisBuild / evictionErrorLevel := Level.Warn

lazy val root = (project in file(".")).settings(
$resolver_block
  libraryDependencies += $dependency_coords,
  Compile / run / mainClass := Some("cozy.Cozy")
)
EOF
  cat > "$LAUNCHER_ROOT/project/build.properties" <<'EOF'
sbt.version=1.11.7
EOF
}

prepare_cozy() {
  rm -f "$STATE_FILE"
  write_launcher_files
  (
    cd "$LAUNCHER_ROOT"
    sbt \
      --batch \
      -Dsbt.server.autostart=false \
      -Dsbt.supershell=false \
      update
  )
  printf '%s\n' "$COZY_VERSION" > "$STATE_FILE"
  echo "prepared cozy launcher: $LAUNCHER_ROOT"
  echo "cozy version: $COZY_VERSION"
}

prepare_cncf() {
  local state_file="$CACHE_ROOT/cncf-samples/cncf-launcher/$cncf_version/.setup-complete"
  rm -f "$state_file"
  if ! command -v java >/dev/null 2>&1; then
    echo "java command not found" >&2
    exit 3
  fi
  local cncf_bin
  if ! cncf_bin="$(find_installed_cncf)"; then
    echo "installed cncf command not found" >&2
    echo "Install it with coursier, for example: cs install cncf" >&2
    echo "If needed, set CNCF_COMMAND=/path/to/cncf." >&2
    exit 3
  fi
  mkdir -p "$(dirname "$state_file")"
  "$cncf_bin" --help >/dev/null
  printf '%s\n' "$cncf_version" > "$state_file"
  echo "java: $(command -v java)"
  echo "cncf command: $cncf_bin"
  echo "cncf version: $cncf_version"
  echo "cncf server port: $cncf_server_port"
  echo "goldenport-core version: $core_version"
  echo "simplemodeling-model version: $simplemodeling_model_version"
}

main() {
  local mode="${1:-bootstrap}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cncf-version)
        cncf_version="${2:-}"
        shift 2
        ;;
      --cncf-version=*)
        cncf_version="${1#--cncf-version=}"
        shift
        ;;
      --core-version)
        core_version="${2:-}"
        shift 2
        ;;
      --cncf-server-port)
        cncf_server_port="${2:-}"
        shift 2
        ;;
      --cncf-server-port=*)
        cncf_server_port="${1#--cncf-server-port=}"
        shift
        ;;
      --core-version=*)
        core_version="${1#--core-version=}"
        shift
        ;;
      --simplemodeling-model-version)
        simplemodeling_model_version="${2:-}"
        shift 2
        ;;
      --simplemodeling-model-version=*)
        simplemodeling_model_version="${1#--simplemodeling-model-version=}"
        shift
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  done

  case "$mode" in
    cncf)
      prepare_cncf
      ;;
    cozy|all|bootstrap)
      prepare_cozy
      if [[ "$mode" != "cozy" ]]; then
        prepare_cncf
      fi
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
