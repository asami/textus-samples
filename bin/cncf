#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../scripts/cncf-common.sh
source "$SCRIPT_DIR/../scripts/cncf-common.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEFAULT_RUNTIME_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cncf-version.conf")"
DEFAULT_SERVER_PORT="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cncf-server-port.conf")"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}"
LAUNCHER_BIN="$REPO_ROOT/bin/launcher"
LAUNCHER_CACHE="$REPO_ROOT/.cache/coursier"
SIMPLEMODELING_REPOSITORY="https://www.simplemodeling.org/maven"

usage() {
  cat >&2 <<'EOF'
Usage:
  cncf [--cncf-version <version>] [--cncf-server-port <port>] [--cncf-main-class <fqcn>] [--command-path <path>] [--discover-classes|--discover=classes] [--workspace <path>] [--repository-dir <path>] [--component-dir <path>] [--] [args...]

Examples:
  ../../bin/setup cncf
  ../../bin/cncf --cncf-version 0.4.2-SNAPSHOT --help
  cd samples/01-minimal
  ../../bin/cncf --discover=classes command minimal.main.hello
  ../../bin/cncf --repository-dir repository.d --textus.runtime.component=minimal command minimal.main.hello

Notes:
  --repository-dir      add packaged artifacts to the search repository
  --component-dir       add packaged artifacts to the active component source
EOF
  exit 1
}

cncf_main_class="org.goldenport.cncf.CncfMain"
runtime_version="${CNCF_VERSION:-$DEFAULT_RUNTIME_VERSION}"
server_port="${CNCF_SERVER_PORT:-$DEFAULT_SERVER_PORT}"
command_path=""
discover_classes="0"
workspace=""
repository_dirs=()
component_dirs=()

resolve_sample_runtime_classpath() {
  local cp_dir="target/cncf.d"
  local cp_file="$cp_dir/runtime-classpath.txt"

  mkdir -p "$cp_dir"

  local sbt_output
  sbt_output="$(sbt --batch 'show Runtime / fullClasspath')"

  printf '%s\n' "$sbt_output" \
    | awk '
        /^\[info\] \* Attributed\(/ {
          line = $0
          sub(/^\[info\] \* Attributed\(/, "", line)
          sub(/\)$/, "", line)
          print line
        }
      ' > "$cp_file"

  if [[ ! -s "$cp_file" ]]; then
    echo "Failed to resolve Runtime / fullClasspath for --discover=classes." >&2
    exit 1
  fi

  paste -sd: "$cp_file"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cncf-version)
      runtime_version="${2:-}"
      shift 2
      ;;
    --cncf-version=*)
      runtime_version="${1#--cncf-version=}"
      shift
      ;;
    --cncf-server-port)
      server_port="${2:-}"
      shift 2
      ;;
    --cncf-server-port=*)
      server_port="${1#--cncf-server-port=}"
      shift
      ;;
    --cncf-main-class)
      cncf_main_class="${2:-}"
      shift 2
      ;;
    --command-path)
      command_path="${2:-}"
      shift 2
      ;;
    --discover-classes|--discover=classes)
      discover_classes="1"
      shift
      ;;
    --workspace)
      workspace="${2:-}"
      shift 2
      ;;
    --repository-dir)
      repository_dirs+=("${2:-}")
      shift 2
      ;;
    --component-dir)
      component_dirs+=("${2:-}")
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

STATE_FILE="$CACHE_ROOT/cncf-samples/cncf-launcher/$runtime_version/.setup-complete"

if [[ ! -x "$LAUNCHER_BIN" || ! -f "$STATE_FILE" ]]; then
  echo "CNCF launcher is not prepared." >&2
  echo "Run: $REPO_ROOT/bin/setup cncf --cncf-version $runtime_version" >&2
  exit 1
fi

classpath=""
if [[ "$discover_classes" == "1" ]]; then
  sample_classpath="$(resolve_sample_runtime_classpath)"
  resolved_runtime_cp="$("$LAUNCHER_BIN" \
    --dependency "org.goldenport:goldenport-cncf_3:$runtime_version" \
    --main-class "$cncf_main_class" \
    --repository "$SIMPLEMODELING_REPOSITORY" \
    --cache "$LAUNCHER_CACHE" \
    --resolve-only)"
  classpath="${resolved_runtime_cp}:${sample_classpath}"
fi

app_args=()
if [[ "$discover_classes" == "1" ]]; then
  app_args+=(--discover=classes)
fi
if [[ -n "$workspace" ]]; then
  app_args+=(--workspace "$workspace")
fi
if [[ ${#repository_dirs[@]} -gt 0 ]]; then
  for dir in "${repository_dirs[@]}"; do
    app_args+=(--repository-dir="$dir")
  done
fi
if [[ ${#component_dirs[@]} -gt 0 ]]; then
  for dir in "${component_dirs[@]}"; do
    app_args+=(--component-dir="$dir")
  done
fi
if [[ -n "$command_path" ]]; then
  app_args+=(command "$command_path")
fi
if [[ $# -gt 0 ]]; then
  app_args+=("$@")
fi

if [[ "$discover_classes" == "1" ]]; then
  exec java \
    -Dcncf.server.port="$server_port" \
    -Dcncf.http.baseurl="http://127.0.0.1:$server_port" \
    -cp "$classpath" \
    "$cncf_main_class" \
    "${app_args[@]}"
else
  exec "$LAUNCHER_BIN" \
    --dependency "org.goldenport:goldenport-cncf_3:$runtime_version" \
    --main-class "$cncf_main_class" \
    --repository "$SIMPLEMODELING_REPOSITORY" \
    --cache "$LAUNCHER_CACHE" \
    --java-opt="-Dcncf.server.port=$server_port" \
    --java-opt="-Dcncf.http.baseurl=http://127.0.0.1:$server_port" \
    -- \
    "${app_args[@]}"
fi
