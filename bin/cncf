#!/usr/bin/env bash
set -euo pipefail

cat >&2 <<'MSG'
cncf-samples/bin/cncf is deprecated.

Use the installed CNCF launcher directly from each sample directory, for example:

  cncf dev command --project . <component.service.operation>
  cncf dev command --project . --no-project-classpath --component-car-dir car.d <operation>
  cncf dev command --project . --no-project-classpath --subsystem-sar-dir sar.d <operation>

Install or update the launcher with Coursier when needed:

  cs install cncf
  cs update cncf
MSG
exit 2
