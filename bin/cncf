#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../scripts/cncf-common.sh
source "$SCRIPT_DIR/../scripts/cncf-common.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEFAULT_RUNTIME_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/versions/cncf-version.conf")"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}"
LAUNCHER_BIN="$REPO_ROOT/bin/launcher"
LAUNCHER_CACHE="$REPO_ROOT/.cache/coursier"
SIMPLEMODELING_REPOSITORY="https://www.simplemodeling.org/maven"

usage() {
  cat >&2 <<'EOF'
Usage:
  cncf [--cncf-version <version>] [--sample-dir <dir>] [--cncf-main-class <fqcn>] [--command-path <path>] [--discover-classes|--discover=classes] [--workspace <path>] [--component-repository <spec>]... [--] [args...]

Examples:
  ../../bin/setup cncf
  ../../bin/cncf --cncf-version 0.4.2-SNAPSHOT --help
  cd samples/01-minimal
  ../../bin/cncf --discover=classes command minimal.main.hello
EOF
  exit 1
}

sample_dir=""
cncf_main_class="org.goldenport.cncf.CncfMain"
runtime_version="${CNCF_VERSION:-$DEFAULT_RUNTIME_VERSION}"
command_path=""
discover_classes="0"
workspace=""
component_repositories=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cncf-version)
      runtime_version="${2:-}"
      shift 2
      ;;
    --cncf-version=*)
      runtime_version="${1#--cncf-version=}"
      shift
      ;;
    --sample-dir)
      sample_dir="${2:-}"
      shift 2
      ;;
    --cncf-main-class)
      cncf_main_class="${2:-}"
      shift 2
      ;;
    --command-path)
      command_path="${2:-}"
      shift 2
      ;;
    --discover-classes|--discover=classes)
      discover_classes="1"
      shift
      ;;
    --workspace)
      workspace="${2:-}"
      shift 2
      ;;
    --component-repository)
      component_repositories+=("${2:-}")
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

repo_root="$(cncf_repo_root)"
if [[ -z "$sample_dir" ]]; then
  sample_dir="$(cncf_sample_dir_from_cwd)"
fi
if [[ -n "$sample_dir" ]]; then
  cd "$repo_root/$sample_dir"
fi

STATE_FILE="$CACHE_ROOT/cncf-samples/cncf-launcher/$runtime_version/.setup-complete"

if [[ ! -x "$LAUNCHER_BIN" || ! -f "$STATE_FILE" ]]; then
  echo "CNCF launcher is not prepared." >&2
  echo "Run: $REPO_ROOT/bin/setup cncf --cncf-version $runtime_version" >&2
  exit 1
fi

classpath=""
if [[ "$discover_classes" == "1" ]]; then
  runtime_cp_file="target/cncf.d/runtime-classpath.txt"
  if [[ ! -f "$runtime_cp_file" ]]; then
    echo "Runtime classpath file not found for --discover=classes: $runtime_cp_file" >&2
    echo "Build the sample first so target/cncf.d/runtime-classpath.txt exists." >&2
    exit 1
  fi
  sample_classpath="$(paste -sd: "$runtime_cp_file")"
  resolved_runtime_cp="$("$LAUNCHER_BIN" \
    --dependency "org.goldenport:goldenport-cncf_3:$runtime_version" \
    --main-class "$cncf_main_class" \
    --repository "$SIMPLEMODELING_REPOSITORY" \
    --cache "$LAUNCHER_CACHE" \
    --resolve-only)"
  classpath="${resolved_runtime_cp}:${sample_classpath}"
fi

app_args=()
if [[ "$discover_classes" == "1" ]]; then
  app_args+=(--discover=classes)
fi
if [[ -n "$workspace" ]]; then
  app_args+=(--workspace "$workspace")
fi
if [[ ${#component_repositories[@]} -gt 0 ]]; then
  for repo in "${component_repositories[@]}"; do
    app_args+=(--component-repository="$repo")
  done
fi
if [[ -n "$command_path" ]]; then
  app_args+=(command "$command_path")
fi
if [[ $# -gt 0 ]]; then
  app_args+=("$@")
fi

if [[ "$discover_classes" == "1" ]]; then
  exec java -cp "$classpath" "$cncf_main_class" "${app_args[@]}"
else
  exec "$LAUNCHER_BIN" \
    --dependency "org.goldenport:goldenport-cncf_3:$runtime_version" \
    --main-class "$cncf_main_class" \
    --repository "$SIMPLEMODELING_REPOSITORY" \
    --cache "$LAUNCHER_CACHE" \
    -- \
    "${app_args[@]}"
fi
